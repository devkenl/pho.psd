<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme (no AppCompat/MDC dependency); Compose draws the whole UI. -->
    <style name="Theme.PhoPsd" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pho_background</item>
        <item name="android:colorAccent">@color/pho_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
